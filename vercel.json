{
  "version": 2,
  "builds": [
    { "src": "main.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "perfil.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/paginas/perfil.html", "dest": "/perfil.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/main.py" }
  ]
}
